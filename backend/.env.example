# ==========================================
# SplitSense V2 Backend Environment Variables
# ==========================================

# Server Port
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection URI (Required)
# Example Local: mongodb://localhost:27017/splitsense_v2
# Example Atlas: mongodb+user:pass@cluster.mongodb.net/splitsense_v2
MONGO_URI=mongodb://localhost:27017/splitsense_v2

# Google Gemini AI API Key (Optional, fallbacks provided if omitted)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# JWT Secret Key (Required for token signing/auth middleware)
JWT_SECRET=your_super_secret_jwt_key_here
