# ============================================
# SplitSense V2 Root Environment Prototype
# ============================================

# Backend Configuration (backend/.env)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/splitsense_v2
GEMINI_API_KEY=your_google_gemini_api_key_here
JWT_SECRET=your_super_secret_jwt_key_here

# Supabase production API (the service-role key belongs only in Supabase Edge Function secrets)
SUPABASE_URL=https://your-project-ref.supabase.co

# Frontend Configuration (frontend/.env)
VITE_API_URL=http://localhost:5000/api
# For the Supabase deployment use:
# VITE_API_URL=https://your-project-ref.supabase.co/functions/v1/api
